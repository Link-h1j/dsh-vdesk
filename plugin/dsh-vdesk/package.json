{
  "name": "@local/dsh-vdesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Child-session virtual desktop for DSH: live view + start/stop + mouse/keyboard takeover.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.svg", "locale/*.json"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}